# This is an example file. Copy it to .env and fill in your actual API keys.
# Do not commit the .env file to version control.

# Pinecone API Key for the Memory Manager
PINECONE_API_KEY="YOUR_PINECONE_API_KEY"

# Reddit API credentials for the Reddit Scraper Skill
REDDIT_CLIENT_ID="YOUR_REDDIT_CLIENT_ID"
REDDIT_CLIENT_SECRET="YOUR_REDDIT_CLIENT_SECRET"

# Twitter API Bearer Token for the Twitter Scraper Skill
TWITTER_BEARER_TOKEN="YOUR_TWITTER_BEARER_TOKEN"
